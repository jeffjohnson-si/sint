{
  "name": "sint-backend",
  "version": "1.0.0",
  "private": true,
  "description": "SINT (Solomon Islands Net Trade) API - business directory with social features",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "seed-media": "node scripts/make-seed-media.mjs",
    "check-env": "node scripts/check-env.js",
    "smoke": "node scripts/smoke.js",
    "test-email": "node scripts/test-email.js",
    "sync-indexes": "node scripts/sync-indexes.js",
    "test": "node --test tests/api.test.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dodopayments": "^2.62.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.9.3",
    "morgan": "1.11.0",
    "multer": "2.2.0",
    "nodemailer": "^10.0.0"
  }
}
