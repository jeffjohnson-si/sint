# Server
PORT=4000
NODE_ENV=development

# Database
# Local development. In production point this at a managed replica set, e.g.
# mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/sint?retryWrites=true&w=majority
# Production skips automatic index builds on boot, so run `npm run sync-indexes`
# after deploying a schema change.
MONGO_URI=mongodb://127.0.0.1:27017/sint

# Auth - CHANGE THESE IN PRODUCTION
JWT_SECRET=dev-only-change-me
JWT_REFRESH_SECRET=dev-only-change-me-too
ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_TTL=30d

# CORS (comma separated). Empty means allow all in development.
CORS_ORIGINS=

# Uploads
UPLOAD_DIR=uploads
MAX_IMAGE_MB=10
MAX_VIDEO_MB=50
PUBLIC_BASE_URL=http://localhost:4000

# Where the customer lands after checkout (Dodo sends them back here).
APP_BASE_URL=http://localhost:8123

# Accounts allowed to approve offline payments (comma separated).
# Empty means nobody can approve, so this is never accidentally left open.
ADMIN_EMAILS=

# Email delivery (Nodemailer). Leave SMTP_HOST blank in dev — messages are
# logged to the console instead. In production, use any SMTP provider:
# SendGrid, Mailgun, Gmail SMTP, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SINT <noreply@sint.sb>

# Whether a lapsed plan blocks publishing. Leave false while card payments are
# not on sale: publishers can post regardless of subscription state. Set true
# once payments go live.
BILLING_ENFORCED=false

# ─── Dodo Payments ────────────────────────────────────────────────────────────
# Leave blank in development — the app shows "not configured" and checkout is
# disabled, while plans, trials and the paywall keep working.
#
# 1. dashboard.dodopayments.com > Products: create two subscription products
#    (monthly and yearly) and copy their ids below.
# 2. Developer > API keys: create a key → DODO_API_KEY.
# 3. Developer > Webhooks: endpoint https://yourdomain.com/api/subscription/webhook
#    with the subscription.* and payment.* events → copy the signing secret into
#    DODO_WEBHOOK_KEY.
#
# The amount charged is whatever each Dodo product is priced at; the SBD prices
# in src/config/constants.js are only what the app displays.
DODO_MODE=test
DODO_API_KEY=
DODO_WEBHOOK_KEY=
DODO_PRODUCT_MONTHLY=
DODO_PRODUCT_YEARLY=
